{
  "info": {
    "_postman_id": "connectly-google-oauth-v1",
    "name": "Connectly – Google OAuth Tests",
    "description": "Live tests for the POST /auth/google/login endpoint — all requests use your real Google ID token and hit your real Django server.\n\n## How this endpoint works\nYou sign in with Google via the OAuth Playground and get a real **Google ID token** (a signed JWT). That token is sent to your Django backend, which validates it live with Google's tokeninfo API, then creates or looks up your Connectly user account, and returns a real DRF auth token.\n\n## Test folders\n| Folder | Purpose | Requires |\n|--------|---------|----------|\n| 1. Valid Token | Real Google login, saves DRF token | `google_id_token` in environment |\n| 2. Second Login | Same token → same account, created=false | Run folder 1 first |\n| 3. Error Handling | Server rejects bad/missing tokens | Nothing — tests bad inputs |\n\n## Prerequisites\n1. Django server running at `{{base_url}}`\n2. `google_id_token` environment variable filled with a real token from https://developers.google.com/oauthplayground\n3. Postman SSL verification OFF (Settings → General) if using self-signed cert",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [

    {
      "name": "1. Valid Token – Google Login (run first)",
      "description": "Real Google login using your actual Google ID token from the OAuth Playground. You MUST paste a fresh token (< 1 hour old) into the `google_id_token` environment variable before running. The test stores the returned DRF token for use in folders 2 and beyond.",
      "item": [

        {
          "name": "01 · Google Login – valid token → 200 + DRF token issued",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var token = pm.environment.get('google_id_token');",
                  "if (!token || token.trim() === '') {",
                  "    throw new Error('STOP: google_id_token is empty. Paste your real Google ID token (eyJ...) into the environment variable first.');",
                  "}",
                  "if (!token.startsWith('eyJ')) {",
                  "    throw new Error('STOP: google_id_token does not look like a real Google ID token. It must start with eyJ (a base64-encoded JWT).');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 – Google accepted the token', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has all required fields', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j).to.have.all.keys('token', 'user_id', 'username', 'email', 'created');",
                  "});",
                  "",
                  "pm.test('DRF token is a real 40-character auth token', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.token).to.be.a('string').and.to.have.lengthOf(40);",
                  "    pm.environment.set('google_drf_token', j.token);",
                  "    pm.environment.set('google_user_email', j.email);",
                  "    pm.environment.set('google_username', j.username);",
                  "    console.log('DRF token saved:', j.token);",
                  "    console.log('Logged in as:', j.email, '| account created:', j.created);",
                  "});",
                  "",
                  "pm.test('created is a boolean (true = new account, false = existing)', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.created).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('email is a real Google email address', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.email).to.be.a('string').and.to.match(/@/);",
                  "    pm.expect(j.email.length).to.be.above(5);",
                  "});",
                  "",
                  "pm.test('user_id is a positive integer', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.user_id).to.be.a('number').and.to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/google/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "login"]
            },
            "description": "REQUIRES: `google_id_token` environment variable must contain a real Google ID token starting with `eyJ`. Get one from https://developers.google.com/oauthplayground (Step 2 → Exchange authorization code for tokens → copy the `id_token` field)."
          },
          "response": []
        },

        {
          "name": "02 · Use returned token – GET /posts/users/me/ → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 – token works on protected endpoints', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Profile email matches Google email', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.email).to.equal(pm.environment.get('google_user_email'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Token {{google_drf_token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/posts/users/me/",
              "host": ["{{base_url}}"],
              "path": ["posts", "users", "me", ""]
            },
            "description": "Calls a protected endpoint using the DRF token returned by the Google login, proving the token grants API access."
          },
          "response": []
        }

      ]
    },

    {
      "name": "2. Valid Token – Second Login (same Google account)",
      "description": "Re-uses the same real Google ID token to log in again. Proves the endpoint is idempotent: same DRF token is returned and `created` is false. Must run folder 1 first in the same session.",
      "item": [

        {
          "name": "03 · Google Login – second login → created=false, same token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var token = pm.environment.get('google_id_token');",
                  "if (!token || !token.startsWith('eyJ')) {",
                  "    throw new Error('STOP: google_id_token is missing. Run folder 1 first.');",
                  "}",
                  "var drf = pm.environment.get('google_drf_token');",
                  "if (!drf || drf.trim() === '') {",
                  "    throw new Error('STOP: google_drf_token is empty. Run test 01 in folder 1 first so the DRF token is stored.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('created is false – account already exists', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.created).to.equal(false);",
                  "});",
                  "",
                  "pm.test('Exact same DRF token returned as first login', function () {",
                  "    var j = pm.response.json();",
                  "    var prev = pm.environment.get('google_drf_token');",
                  "    pm.expect(j.token).to.equal(prev);",
                  "    console.log('Token consistency confirmed:', j.token);",
                  "});",
                  "",
                  "pm.test('Email matches the Google account from folder 1', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.email).to.equal(pm.environment.get('google_user_email'));",
                  "});",
                  "",
                  "pm.test('Username unchanged from first login', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.username).to.equal(pm.environment.get('google_username'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"{{google_id_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/google/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "login"]
            },
            "description": "Uses the same real `google_id_token` from folder 1. Must be run within the token's 1-hour Google validity window."
          },
          "response": []
        }

      ]
    },

    {
      "name": "3. Error Handling",
      "description": "Covers every documented error path without needing a live Google token.",
      "item": [

        {
          "name": "04 · Missing id_token field → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 when id_token is absent', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message mentions id_token', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.error).to.include('id_token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/google/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "login"]
            },
            "description": "Sends an empty JSON object. The endpoint should return 400 because `id_token` is required."
          },
          "response": [
            {
              "name": "400 Bad Request – missing field",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"id_token is required.\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },

        {
          "name": "05 · Empty id_token string → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 when id_token is empty string', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error body present', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j).to.have.property('error');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/google/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "login"]
            },
            "description": "Sends an empty string as the token value."
          },
          "response": [
            {
              "name": "400 Bad Request – empty token",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"id_token is required.\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },

        {
          "name": "06 · Expired / fake token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 for invalid token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error message returned', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.error).to.be.a('string').and.to.have.length.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"this.is.not.a.valid.google.token\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/google/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "login"]
            },
            "description": "Sends a clearly fake token; Google's tokeninfo API will reject it and the server returns 401."
          },
          "response": [
            {
              "name": "401 Unauthorized – invalid token",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Invalid or expired Google token.\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },

        {
          "name": "07 · Tampered JWT (valid structure, bad signature) → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 for tampered JWT', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Generic error message (no internal details leaked)', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j.error).to.not.include('Exception');",
                  "    pm.expect(j.error).to.not.include('Traceback');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"eyJhbGciOiJSUzI1NiIsImtpZCI6ImZha2UifQ.eyJzdWIiOiIxMjM0NTYiLCJlbWFpbCI6InRlc3RAZ21haWwuY29tIiwiYXVkIjoiZmFrZSIsImlzcyI6Imh0dHBzOi8vYWNjb3VudHMuZ29vZ2xlLmNvbSIsImV4cCI6OTk5OTk5OTk5OX0.badsignature\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/google/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "login"]
            },
            "description": "A well-formed JWT with a fake header/payload but an invalid signature. Google's tokeninfo will still reject it."
          },
          "response": [
            {
              "name": "401 Unauthorized – bad signature",
              "status": "Unauthorized",
              "code": 401,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Invalid or expired Google token.\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        },

        {
          "name": "08 · Wrong HTTP method (GET) → 405",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 405 for GET on login endpoint', function () {",
                  "    pm.response.to.have.status(405);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "google", "login"]
            },
            "description": "The endpoint only supports POST. A GET request must return 405 Method Not Allowed."
          },
          "response": [
            {
              "name": "405 Method Not Allowed",
              "status": "Method Not Allowed",
              "code": 405,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"detail\": \"Method \\\"GET\\\" not allowed.\"\n}",
              "_postman_previewlanguage": "json"
            }
          ]
        }

      ]
    }

  ],
  "variable": []
}
